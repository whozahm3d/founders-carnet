{
  "important": ["docs", "rag", "ml", "backend", "frontend", "scripts", ".claude", "CLAUDE.md", "README.md"],
  "data_dirs": ["data", "datasets", "models"],
  "exclude_dirs": ["node_modules", ".venv", "venv", "__pycache__", ".next", "dist", "build", ".git", ".pytest_cache", ".mypy_cache", ".ruff_cache", ".idea", ".vscode"],
