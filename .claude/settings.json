{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(del *)",
      "Bash(rd *)",
      "Bash(erase *)",
      "Bash(unlink *)",
      "Bash(shred *)",
      "PowerShell(Remove-Item *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git rebase *)",
      "Bash(git branch -D *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear*)",
      "Bash(git filter-branch *)",
      "PowerShell(git push *)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",
      "PowerShell(git restore *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git rebase *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git stash drop *)",
      "PowerShell(git stash clear*)",
      "PowerShell(git filter-branch *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(./_backup_mirror/**)",
      "Read(./.claude/backups/**)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Edit(**/.env.development)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/scripts/backup.py)",
      "Edit(/scripts/backup_config.json)",
      "Edit(/_backup_mirror/**)",
      "Edit(/.claude/backups/**)"
    ],
    "ask": [
      "Bash(git commit *)",
      "PowerShell(git commit *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(python -m pip install *)",
      "Bash(python3 -m pip install *)",
      "Bash(py -m pip install *)",
      "PowerShell(pip install *)",
      "PowerShell(pip3 install *)",
      "PowerShell(python -m pip install *)",
      "PowerShell(py -m pip install *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py"],
            "timeout": 30,
            "statusMessage": "Saving a backup copy..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/backup.py", "mirror", "--quiet"],
            "timeout": 120
          }
        ]
      }
    ]
  }
}
