# Rename this file to .env.example (add the dot), commit that, then copy it to .env and fill in real values.
# Never commit .env. Real keys and passwords go only in .env, which git ignores.
# Names below are placeholders for the stack in CLAUDE.md. Rename them to match the code.

# LLM Gateway (Google AI Studio free tier)
GEMINI_API_KEY=
# Keep the model ID in config, not in code. Use a Gemini 2.5 or older model ID.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/carnet

# Redis and Celery
REDIS_URL=redis://localhost:6379/0

# Auth (JWT)
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend. Anything starting with NEXT_PUBLIC_ is visible in the browser, so never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK=true
