# Copy this template to the repository-root .env and fill in local values.
# Never commit .env. Real keys and passwords go only in .env, which git ignores.
# This example matches backend/app/config.py. Copy it to the repository-root .env for local use.

# LLM Gateway (Google AI Studio free tier)
GEMINI_API_KEY=replace-with-your-Google-AI-Studio-key
# Keep the model ID in config, not in code. Use a Gemini 2.5 or older model ID.
GEMINI_MODEL=gemini-2.5-flash
# Optional; only used if the primary model is unavailable or repeatedly fails transiently.
GEMINI_FALLBACK_MODEL=
GEMINI_REQUEST_TIMEOUT_MS=60000
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# Market research web search (Firecrawl)
FIRECRAWL_API_KEY=replace-with-your-Firecrawl-key
FIRECRAWL_REQUEST_TIMEOUT_MS=25000

# Profile verification defaults are pilot thresholds and need reviewer calibration.
VERIFICATION_LOW_THRESHOLD=0.50
VERIFICATION_HIGH_THRESHOLD=0.85

# Optional: set RESUME_STORAGE_DIR to a private directory outside frontend/public.

# Local PostgreSQL with pgvector (compose.yaml)
CARNET_DB_PASSWORD=replace-with-random-32-character-alphanumeric-value
DATABASE_URL=postgresql+psycopg://founders_carnet:replace-with-random-32-character-alphanumeric-value@localhost:5432/founders_carnet

# Redis broker/backend used by the API and Celery worker. The Compose services
# override this inside the network; localhost is for commands run on the host.
REDIS_URL=redis://localhost:6379/0

# Auth (JWT)
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend. Anything starting with NEXT_PUBLIC_ is visible in the browser, so never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK=true
